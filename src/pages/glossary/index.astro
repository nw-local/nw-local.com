---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GlossarySearch from "../../components/GlossarySearch.astro";
import { getGlossaryTerms } from "../../lib/sanity";
import {
  buildBreadcrumbList,
  normalizeSiteUrl,
  type StructuredData,
  requireSiteUrl,
} from "../../lib/jsonld";
import { GLOSSARY_BASE_PATH } from "../../lib/routes";

const terms = await getGlossaryTerms() ?? [];

const siteUrl = requireSiteUrl( Astro.site );
const baseUrl = normalizeSiteUrl( siteUrl );
const structuredData: StructuredData[] = [
  buildBreadcrumbList( [
    { name: "Home", url: `${baseUrl}/` },
    { name: "Glossary", url: `${baseUrl}${GLOSSARY_BASE_PATH}/` },
  ] ),
];
---

<Layout
  title="Glossary"
  description="Definitions for the cannabis cultivation and science terms used across Northwest Local Cannabis."
  structuredData={structuredData}
>
  <Hero title="Glossary" subtitle="Clear definitions for cannabis cultivation, plant science, and production." />

  {terms.length > 0
    ? <GlossarySearch terms={terms} />
    : <p class="glossary-no-terms">No terms yet. Check back soon.</p>}
</Layout>
