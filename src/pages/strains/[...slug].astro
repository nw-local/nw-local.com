---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import PortableText from "../../components/PortableText.astro";
import ProductBadge from "../../components/ProductBadge.astro";
import ProductCard from "../../components/ProductCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getStrains, getStrain, getProductsByStrain, getDrops } from "../../lib/sanity";
import { buildDropLookup, dropHref } from "../../lib/drops";
import { cultiveraMarketUrlFor } from "../../lib/cultivera";
import { urlFor } from "../../lib/image";
import { formatMonthYear } from "../../lib/date";
import {
  buildBreadcrumbList,
  buildProduct,
  normalizeSiteUrl,
  type StructuredData,
  requireSiteUrl,
} from "../../lib/jsonld";

// getDrops() is called here rather than in the frontmatter on purpose: Astro
// runs getStaticPaths() once per route file and the frontmatter once per
// generated page, so fetching below would be one network round trip per strain.
export async function getStaticPaths() {
  const strains = await getStrains() ?? [];
  const drops = await getDrops() ?? [];
  const dropLookup = buildDropLookup( drops );
  return strains.map( ( strain: { _id: string; slug: { current: string } }) => {
    // byStrainId answers "is any product of this strain in a drop", which is a
    // strain-level statement and is exactly what the "In this drop" line below
    // says. It is not a per-SKU answer: a drop bundles selected SKUs, so a drop
    // holding the eighth and not the pre-roll must not badge the pre-roll.
    // Carry the winning drop's product ids so each card can test membership.
    const drop = dropLookup.byStrainId.get( strain._id );
    const winningDrop = drops.find( candidate => candidate._id === drop?._id );
    return {
      params: { slug: strain.slug.current },
      props: { drop, dropProductIds: winningDrop?.productIds ?? [] },
    };
  });
}

const { slug } = Astro.params;
const { drop, dropProductIds } = Astro.props;
const strain = await getStrain( slug! );
if( !strain ) return Astro.redirect( "/strains" );

const products = await getProductsByStrain( strain._id ) ?? [];
// The product cards here carry no strain reference (ProductWithDescription), so
// the "Order on Cultivera" link is resolved from this strain and passed down.
const orderUrl = cultiveraMarketUrlFor( strain.cultiveraMarketProductId );
const ogImage = strain.heroImage?.asset ? urlFor( strain.heroImage ).width( 1200 ).height( 630 ).format( "jpg" ).url() : undefined;

const lightboxImages = ( strain.gallery ?? [] ).map( ( image: { asset: unknown; alt?: string }) => ({
  // Width only, deliberately: constraining height as well would letterbox
  // portrait gallery shots. Unconstrained, each image keeps its natural ratio.
  url: urlFor( image ).width( 1600 ).format( "webp" ).url(),
  alt: image.alt ?? strain.name,
}) );

const siteUrl = requireSiteUrl( Astro.site );
const baseUrl = normalizeSiteUrl( siteUrl );
const structuredData: StructuredData[] = [
  buildProduct( strain, siteUrl, ogImage, "Northwest Local Cannabis" ),
  buildBreadcrumbList( [
    { name: "Home", url: `${baseUrl}/` },
    { name: "Strains", url: `${baseUrl}/strains/` },
    { name: strain.name, url: `${baseUrl}/strains/${strain.slug.current}/` },
  ] ),
];
---

<Layout title={strain.name} description={`${strain.name} is a ${strain.strainType} cannabis strain by Northwest Local Cannabis.`} ogImage={ogImage} structuredData={structuredData}>
  <Hero title={strain.name}>
    <div style="display:flex;align-items:center;gap:0.75rem;margin-top:0.5rem;">
      <ProductBadge type={strain.strainType} />
      {strain.thcRange && <span style="color:var(--text-secondary);font-size:0.9rem;">THC: {strain.thcRange}</span>}
      {strain.cbdRange && <span style="color:var(--text-secondary);font-size:0.9rem;">CBD: {strain.cbdRange}</span>}
    </div>
    {strain.lineage && <p class="strain-lineage"><em>{strain.lineage}</em></p>}
  </Hero>

  <div class="detail-grid">
    <div>
      {strain.heroImage?.asset && (
        <img
          src={urlFor( strain.heroImage ).width( 1200 ).height( 900 ).format( "webp" ).url()}
          alt={strain.heroImage.alt ?? strain.name}
          width="1200"
          height="900"
          style="border-radius:8px;width:100%;object-fit:cover;"
        />
      )}
    </div>
    <div>
      {strain.description && <PortableText value={strain.description} />}

      {strain.effects && strain.effects.length > 0 && (
        <div style="margin-top:1.5rem;">
          <h2 class="detail-label">Effects</h2>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            {strain.effects.map( ( effect: string ) => (
              <span class="product-badge">{effect}</span>
            ) )}
          </div>
        </div>
      )}

      {strain.terpenes && strain.terpenes.length > 0 && (
        <div style="margin-top:1.5rem;">
          <h2 class="detail-label">Terpenes</h2>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            {strain.terpenes.map( ( terpene: string ) => (
              <a href={`/terpenes/${terpene.toLowerCase()}`} class="product-badge terpene-link">{terpene}</a>
            ) )}
          </div>
        </div>
      )}

      {strain.nextHarvestDate && (
        <p style="margin-top:1.5rem;color:var(--accent);font-weight:600;">
          Next harvest: {formatMonthYear( strain.nextHarvestDate )}
        </p>
      )}
    </div>
  </div>

  {strain.gallery && strain.gallery.length > 0 && (
    <section class="fade-in" style="margin-bottom:3rem;">
      <SectionHeading title="Gallery" />
      <div class="gallery-grid">
        {strain.gallery.map( ( image, index ) => (
          <img
            src={urlFor( image ).width( 600 ).height( 600 ).format( "webp" ).url()}
            alt={image.alt ?? strain.name}
            width="600"
            height="600"
            class="gallery-thumb"
            data-lightbox-index={index}
            loading="lazy"
          />
        ) )}
      </div>
    </section>
  )}

  <ImageLightbox images={lightboxImages} />

  {drop && (
    <p class="strain-drop-line">In this drop: <a href={dropHref( drop.slug )}>{drop.name}</a></p>
  )}

  {products.length > 0 && (
    <section class="fade-in">
      <SectionHeading title="Products" />
      <div class="card-grid">
        {products.map( product => (
          <ProductCard {...product} orderUrl={orderUrl} drop={dropProductIds.includes( product._id ) ? drop : undefined} />
        ) )}
      </div>
    </section>
  )}
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .gallery-thumb {
    border-radius: 8px;
    object-fit: cover;
    width: 100%;
    aspect-ratio: 1;
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .gallery-thumb:hover {
    transform: scale(1.03);
    filter: brightness(1.1);
  }
</style>
