---
import Layout from "../../layouts/Layout.astro";
import PesticideDisclosureBody from "../../components/PesticideDisclosureBody.astro";
import {
  getPesticideDisclosureByPublicCode,
  getPesticideDisclosures,
  preparePesticideDisclosureStaticPaths,
  resolvePesticideDisclosureRouteDocument,
} from "../../lib/sanity";

export async function getStaticPaths() {
  return preparePesticideDisclosureStaticPaths( await getPesticideDisclosures() );
}

const { code } = Astro.params;
if( !code ) throw new Error( "Pesticide disclosure route requires a lot code." );
const normalizedCode = code.toUpperCase();

const directlyFetched = await getPesticideDisclosureByPublicCode( normalizedCode );
if( !directlyFetched ) return Astro.redirect( "/pesticides" );
const disclosure = resolvePesticideDisclosureRouteDocument( normalizedCode, directlyFetched );

const pageTitle = `Pesticide disclosure: lot ${disclosure.publicCode}`;
const description = `Pesticides applied to lot ${disclosure.publicCode} (${disclosure.strain}) from Northwest Local Cannabis.`;
---

<Layout title={pageTitle} description={description}>
  <PesticideDisclosureBody {disclosure} />
</Layout>
