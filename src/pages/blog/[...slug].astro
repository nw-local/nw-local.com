---
import Layout from "../../layouts/Layout.astro";
import PortableText from "../../components/PortableText.astro";
import AuthorByline from "../../components/AuthorByline.astro";
import { getBlogPosts, getBlogPost, getSiteSettings } from "../../lib/sanity";
import { urlFor } from "../../lib/image";
import { formatPostDate } from "../../lib/date";
import {
  buildArticle,
  buildBreadcrumbList,
  normalizeSiteUrl,
  type StructuredData,
  requireSiteUrl,
} from "../../lib/jsonld";

export async function getStaticPaths() {
  const posts = await getBlogPosts() ?? [];
  return posts.map( ( post: { slug: { current: string } }) => ({
    params: { slug: post.slug.current },
  }) );
}

const { slug } = Astro.params;
const post = await getBlogPost( slug! );
if( !post ) return Astro.redirect( "/blog" );

const formattedDate = formatPostDate( post.publishedAt );
const ogImage = post.heroImage?.asset ? urlFor( post.heroImage ).width( 1200 ).height( 630 ).format( "jpg" ).url() : undefined;
const authorImageUrl = post.author?.photo?.asset
  ? urlFor( post.author.photo ).width( 400 ).height( 400 ).fit( "crop" ).format( "jpg" ).url()
  : undefined;

const settings = await getSiteSettings();
const siteUrl = requireSiteUrl( Astro.site );
const baseUrl = normalizeSiteUrl( siteUrl );
const postUrl = `${baseUrl}/blog/${post.slug.current}/`;
const structuredData: StructuredData[] = [
  buildArticle({ post, siteUrl, settings, heroImageUrl: ogImage, authorImageUrl }),
  buildBreadcrumbList( [
    { name: "Home", url: `${baseUrl}/` },
    { name: "Blog", url: `${baseUrl}/blog/` },
    { name: post.title, url: postUrl },
  ] ),
];

// Shown only when the page is printed, so a PDF that gets forwarded still says
// where it came from. The scheme and the trailing slash are stripped because a
// reader retypes this rather than clicking it; the canonical form stays in the
// breadcrumb above, which is what machines read.
const printSourceUrl = postUrl.replace( /^https?:\/\//, "" ).replace( /\/$/, "" );
---

<Layout title={post.title} description={post.description} ogImage={ogImage} structuredData={structuredData}>
  <article class="post-article">
    <header style="margin-bottom:2rem;">
      <p style="font-size:0.75rem;color:var(--accent);text-transform:uppercase;letter-spacing:1px;margin-bottom:0.5rem;">
        {formattedDate}
      </p>
      <h1>{post.title}</h1>
      <div class="hero-accent"></div>
      {post.author && (
        <div style="margin-top:1rem;">
          <AuthorByline author={post.author} />
        </div>
      )}
      {post.tags && post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map( ( tag: string ) => (
            <span class="product-badge">{tag}</span>
          ) )}
        </div>
      )}
    </header>

    {post.heroImage?.asset && (
      <img
        class="post-hero"
        src={urlFor( post.heroImage ).width( 1200 ).height( 600 ).format( "webp" ).url()}
        alt={post.heroImage.alt ?? ""}
        width="1200"
        height="600"
      />
    )}

    {post.body && <PortableText value={post.body} />}

    <p class="print-source">
      {settings?.siteTitle && <span class="print-source-site">{settings.siteTitle}</span>}
      <span class="print-source-url">{printSourceUrl}</span>
    </p>
  </article>
</Layout>
