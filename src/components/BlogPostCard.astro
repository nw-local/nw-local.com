---
import { urlFor } from "../lib/image";
import { formatPostDate } from "../lib/date";
import type { BlogPostSummary } from "../lib/sanity";

type Props = BlogPostSummary;

const { title, slug, description, publishedAt, heroImage, author } = Astro.props;
const formattedDate = formatPostDate( publishedAt );
---

<a href={`/blog/${slug.current}`} class="card">
  <div class="card-image">
    {heroImage?.asset && (
      <img
        src={urlFor( heroImage ).width( 600 ).height( 375 ).format( "webp" ).url()}
        alt={heroImage.alt ?? title}
        width="600"
        height="375"
        loading="lazy"
      />
    )}
  </div>
  <div class="card-body">
    <p style="font-size:0.75rem;color:var(--accent);text-transform:uppercase;letter-spacing:1px;margin-bottom:0.5rem;">
      {formattedDate}{author && ` · ${author.name}`}
    </p>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>
