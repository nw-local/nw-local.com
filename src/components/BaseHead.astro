---
import "../styles/global.css";
import JsonLd from "./JsonLd.astro";
import type { StructuredData } from "../lib/jsonld";

interface Props {
  title: string
  description?: string
  ogImage?: string
  structuredData?: StructuredData[]
}

const GOOGLE_ANALYTICS_ID = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;

if( !GOOGLE_ANALYTICS_ID ) throw new Error( "Missing PUBLIC_GOOGLE_ANALYTICS_ID env var" );

// The Google Analytics snippet at the bottom of this file is copied verbatim
// from Google and must stay that way. Two details in it are load-bearing, and
// this rationale lives here rather than beside them because comments inside a
// define:vars script are shipped to every visitor, while frontmatter is not.
//
// 1. `function gtag(){ dataLayer.push(arguments) }` — gtag.js does not execute
//    the entries it finds on dataLayer, it inspects them, and it only treats an
//    entry as a gtag command when that entry is an `arguments` object. Rest
//    params push a plain Array, which it reads as legacy GTM data and ignores.
//    The tag still loads, google_tag_data still initialises, and no hit is ever
//    sent. Nothing in lint, astro check, the build, or the link checker can see
//    this; the only symptom is the absence of a request to
//    google-analytics.com/g/collect. It shipped that way in c154186 and went
//    unnoticed from 2026-05-01 to 2026-08-19. ESLint's prefer-rest-params
//    argues for the broken form, so it is scoped off for this file in
//    eslint.config.mjs, and scripts/check-analytics-snippet.sh fails the build
//    if the shipped HTML ever loses the `arguments` push.
//
// 2. `window.gtag = gtag` — define:vars wraps the script in an IIFE, so the
//    snippet's `function gtag` is closure-scoped instead of global the way
//    Google's copy-paste assumes. Without the assignment the first
//    gtag( "event", ... ) anyone adds throws ReferenceError.

const canonicalURL = new URL( Astro.url.pathname, Astro.site );
const { title, description, ogImage, structuredData = [] } = Astro.props;
const resolvedOgImage = ogImage ?? new URL( "/og-default.jpg", Astro.site ).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />

{structuredData.map( data => <JsonLd data={data} /> )}

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_ID}`}></script>
<script define:vars={{ GOOGLE_ANALYTICS_ID }}>
  // Vendor snippet: `arguments` and `window.gtag` are load-bearing. See the frontmatter above.
  window.dataLayer = window.dataLayer || [];
  function gtag() {dataLayer.push( arguments );}
  window.gtag = gtag;
  gtag( "js", new Date() );
  gtag( "config", GOOGLE_ANALYTICS_ID );
</script>
