---
import type { SanityImage } from "../lib/sanity";
import { urlFor, resolveImageDimensions } from "../lib/image";

interface Props {
  image?: SanityImage
}

const { image } = Astro.props;

// Same empty-object guard as Hero: a cleared Sanity image field is truthy.
const backdrop = image?.asset ? image : undefined;

// Sanity will happily upscale a small source and return double the bytes for no
// extra detail, so cap the request at the asset's own width. The backdrop is
// full-bleed, so the ceiling is a retina-density common desktop width rather
// than anything derived from the content column.
const backdropWidth = backdrop
  ? Math.min( 3000, resolveImageDimensions( backdrop.asset, "Hero backdrop image" ).width )
  : 0;

// Responsive candidates, clamped to the same source-width ceiling as
// backdropWidth above so a phone never pulls a desktop-sized (or upscaled)
// file.
//
// sizes is 100vw because the backdrop breaks out of main and spans the
// viewport. Treat that as a floor rather than an exact figure: the parallax
// makes the image 140% of the box height, which can flip `object-fit: cover`
// from scaling by width to scaling by height, and a height-scaled image is
// wider than the viewport. On a 1280px-wide desktop hero the image renders at
// roughly 1440 CSS px, so the browser can select one candidate lower than it
// ideally would. Candidate rounding absorbs most of that on desktop; the gap
// is larger on narrow screens, where the box is tall relative to its width.
// Correcting it properly needs breakpointed sizes, which is a bandwidth
// tradeoff rather than a straight win — see PR #45's review.
const backdropSrcSetWidths = backdrop
  ? [ ...new Set( [ 480, 800, 1200, 1600, 2000, 2400, backdropWidth ].filter( width => width <= backdropWidth ) ) ]
  : [];
const backdropSrcSet = backdrop
  ? backdropSrcSetWidths
    .map( width => `${urlFor( backdrop ).width( width ).format( "webp" ).url()} ${width}w` )
    .join( ", " )
  : undefined;
---

{backdrop ? (
  <div class="hero-backdrop">
    {/* fetchpriority="high" is deliberate here and on Hero's lockup img: which
        image is the LCP element depends on fallback state (this photo when
        present, the lockup when it is not), so one hint cannot cover both
        without conditional plumbing. */}
    <img
      class="hero-backdrop-image"
      src={urlFor( backdrop ).width( backdropWidth ).format( "webp" ).url()}
      srcset={backdropSrcSet}
      sizes="100vw"
      alt=""
      fetchpriority="high"
    />
    <div class="hero-backdrop-scrim"></div>
    <div class="hero-backdrop-content">
      <slot />
    </div>
  </div>
) : (
  <slot />
)}
