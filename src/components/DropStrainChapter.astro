---
import CultiveraImageLink from "./CultiveraImageLink.astro";
import PortableText from "./PortableText.astro";
import ProductBadge from "./ProductBadge.astro";
import type { DropChapter } from "../lib/drops";
import { DROP_CHAPTER_STATE_BADGE_TYPES, dropCoaHref, dropProductSizeLabel, formatDropTotalThc } from "../lib/drops";
import { cultiveraMarketUrlFor } from "../lib/cultivera";
import { urlFor } from "../lib/image";
import type { CoaStatus } from "../lib/coa.ts";

interface Props {
  chapter: DropChapter
  chapterCount: number
}

const COA_LINK_PREFIX = "Release COA";
const COA_STATUS_LABELS: Record<CoaStatus, string> = { pass: "Pass", fail: "Fail" };

const { chapter, chapterCount } = Astro.props;
const { strain, products, available, coa } = chapter;
// The buy link is per strain — one marketplace product groups every package
// size — so it is resolved once here. The strain photo carries it (see
// CultiveraImageLink): the photo links out quietly, with no marketplace label.
const orderUrl = cultiveraMarketUrlFor( strain.cultiveraMarketProductId );
const stateType = available ? DROP_CHAPTER_STATE_BADGE_TYPES.available : DROP_CHAPTER_STATE_BADGE_TYPES.soldOut;
const pad = ( value: number ) => String( value ).padStart( 2, "0" );
const strainHref = strain.slug ? `/strains/${strain.slug.current}` : undefined;
const heroImage = strain.heroImage?.asset ? strain.heroImage : undefined;
---

<section class="drop-chapter fade-in" id={chapter.anchorId} data-drop-chapter={chapter.anchorId} style={`--drop-color: ${chapter.color};`}>
  <div class="drop-chapter-band"></div>

  <header class="drop-chapter-header">
    <div class="drop-chapter-heading">
      <p class="drop-chapter-number">{pad( chapter.index )} / {pad( chapterCount )}</p>
      <h2 class="drop-chapter-title">{strainHref ? <a href={strainHref}>{strain.name}</a> : strain.name}</h2>
      {strain.lineage && (
        <p class="drop-chapter-lineage" data-drop-lineage={strain.lineage}><em>{strain.lineage}</em></p>
      )}
    </div>
    <div class="drop-chapter-stats">
      {coa?.totalThc && (
        <p class="drop-chapter-thc" data-drop-thc={coa.totalThc.value}>{formatDropTotalThc( coa.totalThc )}</p>
      )}
      <div class="drop-chapter-badges" data-drop-state={stateType}>
        <ProductBadge type={stateType} />
        {strain.strainType && <ProductBadge type={strain.strainType} />}
      </div>
    </div>
  </header>

  <div class="drop-chapter-body">
    <div class="drop-chapter-media">
      {heroImage && (
        <CultiveraImageLink orderUrl={orderUrl} ariaName={strain.name} frameClass="drop-chapter-media-frame">
          <img
            class="drop-chapter-hero"
            src={urlFor( heroImage ).width( 1200 ).height( 900 ).format( "webp" ).url()}
            alt={heroImage.alt ?? strain.name}
            width="1200"
            height="900"
            loading="lazy"
          />
        </CultiveraImageLink>
      )}
    </div>

    <div class="drop-chapter-text">
      {strain.description && <div class="drop-chapter-copy"><PortableText value={strain.description} /></div>}
      {coa && (
        <a class="drop-coa-link" data-drop-coa={coa.sourceId} href={dropCoaHref( coa.sourceId )}>{COA_LINK_PREFIX} · {COA_STATUS_LABELS[coa.status]}</a>
      )}
    </div>
  </div>

  {products.length > 0 && (
    <table class="drop-packages" data-drop-products>
      <thead>
        <tr>
          <th scope="col">Size</th>
          <th scope="col">Weight</th>
          <th scope="col" class="drop-packages-end">Availability</th>
        </tr>
      </thead>
      <tbody>
        {products.map( product => (
          <tr class="drop-package-row" data-drop-product={product._id} data-available={product.available === true ? "true" : "false"}>
            <td class="drop-package-name">{dropProductSizeLabel( product.name, strain.name )}</td>
            <td class="drop-package-weight">{product.weight}</td>
            <td class="drop-package-state drop-packages-end">{product.available === true ? "In stock" : "Sold out"}</td>
          </tr>
        ) )}
      </tbody>
    </table>
  )}
</section>
