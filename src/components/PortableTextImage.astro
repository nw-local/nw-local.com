---
import { urlFor, imageDimensions } from "../lib/image";

export interface PortableTextImageNode {
  _type: "image";
  _key?: string;
  asset?: { _ref?: string };
  alt?: string;
  caption?: string;
}

interface Props {
  node: PortableTextImageNode;
}

const { node } = Astro.props;

// astro-portabletext renders unhandled node types into a display:none div, so a
// malformed image block would vanish from the page instead of failing. Reject it
// at build time rather than shipping a post with a hole in it.
const assetRef = node.asset?._ref;
if( !assetRef ) {
  throw new Error(
    `Portable Text image block ${node._key ?? "(no _key)"} has no asset reference. `
    + "Attach an image to the block in Sanity Studio or remove the block.",
  );
}

const { width, height } = imageDimensions( assetRef );
const displayWidth = Math.min( width, 1400 );
const displayHeight = Math.round( displayWidth * ( height / width ) );
---

<figure>
  <img
    src={urlFor( node ).width( displayWidth ).format( "webp" ).url()}
    alt={node.alt ?? ""}
    width={displayWidth}
    height={displayHeight}
    loading="lazy"
    decoding="async"
  />
  {node.caption && <figcaption>{node.caption}</figcaption>}
</figure>
