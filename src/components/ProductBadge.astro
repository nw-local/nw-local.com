---
import { DROP_STATUS_LABELS } from "../lib/drops";

interface Props {
  type: string
  label?: string
}

const { type, label } = Astro.props;

const LABELS: Record<string, string> = {
  indica: "Indica",
  sativa: "Sativa",
  hybrid: "Hybrid",
  flower: "Flower",
  preroll: "Pre-Roll",
  concentrate: "Concentrate",
  edible: "Edible",
  other: "Other",
  // Drop statuses come from drops.ts so the badge and the drops index filter
  // cannot word the same status two ways.
  ...DROP_STATUS_LABELS,
};
---

<span class="product-badge" data-type={type}>
  {label ?? LABELS[type] ?? type}
</span>
