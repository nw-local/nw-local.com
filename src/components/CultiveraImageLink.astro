---
// The shared mechanic for "this photo quietly links to the marketplace": wrap an
// image in an anchor with no visible label, so the photo promotes the strain and
// the brand rather than advertising the marketplace. Callers pass the <img> as
// the default slot, so each context keeps its own image sizing and src building.
// The frame is an <a> only when there is an orderUrl; otherwise it is a plain
// <div> so the surrounding markup and layout stay identical. The frame shape and
// hover cue are left to each caller's CSS (see .drop-chapter-media-frame vs
// .card-image-frame).
interface Props {
  orderUrl?: string;
  // Screen-reader-only name for the link, e.g. "Order Glitter Bomb". Names the
  // action and the strain, not the marketplace, so nothing advertises Cultivera.
  ariaName: string;
  frameClass: string;
}

const { orderUrl, ariaName, frameClass } = Astro.props;
const Frame = orderUrl ? "a" : "div";
const frameProps = orderUrl
  ? { href: orderUrl, target: "_blank", rel: "noopener", "data-order-cultivera": true, "aria-label": `Order ${ariaName}` }
  : {};
---

<Frame class={frameClass} {...frameProps}>
  <slot />
</Frame>
