---
import { urlFor } from "../lib/image";
import CultiveraImageLink from "./CultiveraImageLink.astro";
import ProductBadge from "./ProductBadge.astro";
import { dropHref } from "../lib/drops";
import type { DropRef } from "../lib/drops";
import type { ProductSummary, ProductWithDescription } from "../lib/sanity";
import { ORDER_ON_CULTIVERA_LABEL, cultiveraMarketUrlFor } from "../lib/cultivera";

// orderUrl is passed explicitly where the caller holds the strain but the card
// does not (the strain page renders ProductWithDescription, which carries no
// strain reference). Everywhere else the card derives it from its own strain.
type Props = ( ProductSummary | ProductWithDescription ) & { drop?: DropRef; orderUrl?: string };

const { name, category, weight, available, image, drop } = Astro.props;
const strain = "strain" in Astro.props ? Astro.props.strain : undefined;
const displayImage = image ?? strain?.heroImage;
const orderUrl = Astro.props.orderUrl ?? cultiveraMarketUrlFor( strain?.cultiveraMarketProductId );
---

<div class="card">
  <div class="card-image">
    {displayImage?.asset && (
      <CultiveraImageLink orderUrl={orderUrl} ariaName={name} frameClass="card-image-frame">
        <img
          src={urlFor( displayImage ).width( 600 ).height( 375 ).format( "webp" ).url()}
          alt={displayImage.alt ?? name}
          width="600"
          height="375"
          loading="lazy"
        />
      </CultiveraImageLink>
    )}
  </div>
  <div class="card-body">
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
      <ProductBadge type={category} />
      {weight && <span class="product-badge">{weight}</span>}
      {!available && <span class="product-badge">Unavailable</span>}
    </div>
    <h3 class="card-title">{name}</h3>
    {strain && (
      <p>
        <a href={`/strains/${strain.slug.current}`}>
          {strain.name}
        </a>
        {" · "}
        <ProductBadge type={strain.strainType} />
      </p>
    )}
    {drop && (
      <p style="display:flex;align-items:center;gap:0.5rem;">
        <ProductBadge type={drop.status} />
        <a href={dropHref( drop.slug )}>{drop.name}</a>
      </p>
    )}
    {orderUrl && !displayImage?.asset && (
      <a class="cultivera-textlink" data-order-cultivera href={orderUrl} target="_blank" rel="noopener">{ORDER_ON_CULTIVERA_LABEL}<span aria-hidden="true"> ↗</span></a>
    )}
  </div>
</div>
