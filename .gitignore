# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# rendered figures
# The SVG under figures/ is the source and is tracked; the PNG beside it is a
# build artifact of `make render-figures`, and the copy that matters lives in
# Sanity once it is uploaded. Photographs a figure composes are source, not
# output, so figures/**/src/ is tracked: losing them would make the figure
# unrebuildable, which is the whole point of tracking sources.
figures/**/*.png
!figures/**/src/*.png
figures/**/.render-*.html

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# sanity studio
studio/node_modules/
studio/dist/

# brainstorming companion
.superpowers/

# playwright mcp artifacts
.playwright-mcp/

# claude code worktrees
# EnterWorktree creates linked worktrees here. Untracked and unignored, a
# `git add -A` in the main checkout would commit an entire worktree tree.
.claude/worktrees/
# Superpowers' git-worktree fallback creates linked worktrees here for the
# same reason; same hazard, same rule.
.worktrees/

# python bytecode
# scripts/ holds several .py checks that import each other, so running one
# leaves a __pycache__ beside them. Committing it would ship stale bytecode
# and churn the diff on every local run.
__pycache__/
*.pyc
